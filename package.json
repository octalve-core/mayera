{
  "name": "mayera-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:clean": "pnpm clean && pnpm dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "orders:release-expired": "node scripts/release-expired-orders.mjs",
    "email:send-queued": "node scripts/send-email-queue.mjs",
    "setup": "node scripts/setup-check.mjs",
    "doctor": "node scripts/setup-check.mjs",
    "clean": "node scripts/clean-next.mjs",
    "tree": "node scripts/print-tree.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.6",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
