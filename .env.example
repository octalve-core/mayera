# Public storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Neon PostgreSQL (required for accounts, live checkout, admin and super-admin)
# Leave this blank for a public-store-only local preview. Do not assume that
# your PostgreSQL username or password is "postgres".
DATABASE_URL=
# Use Neon's pooled connection string above and its direct/unpooled connection
# string below. Both must include SSL as supplied by Neon.
DIRECT_URL=
# Example shape only: postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# Application security — run `pnpm secrets:generate`, then add these only in
# your private .env.local file or Vercel environment settings.
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=
MAYERA_SETUP_TOKEN=
SESSION_TTL_HOURS=168
PENDING_ORDER_TTL_MINUTES=30

# Paystack. Use test keys locally; checkout is disabled when these are blank.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/success

# Transactional email (Resend-compatible REST API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Nigeria-first shipping configuration (amounts are in kobo)
MAYERA_STANDARD_DELIVERY_KOBO=250000
MAYERA_FREE_DELIVERY_THRESHOLD_KOBO=2500000
MAYERA_FREE_DELIVERY_ENABLED=false

# Optional S3/R2-compatible media storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_REGION=auto
